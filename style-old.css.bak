@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

:root {
  /* Colors */
  --bg-primary: #060814;
  --bg-secondary: #0c1024;
  --bg-tertiary: #131936;
  --accent-indigo: #6366f1;
  --accent-cyan: #06b6d4;
  --accent-violet: #8b5cf6;
  --accent-glow: rgba(99, 102, 241, 0.15);
  
  /* Text */
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  /* Glassmorphism */
  --glass-bg: rgba(12, 16, 36, 0.65);
  --glass-border: rgba(255, 255, 255, 0.06);
  --glass-glow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  
  /* Transitions */
  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  
  /* Fonts */
  --font-display: 'Outfit', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
}

/* Global Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  overflow-x: hidden;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-secondary);
  font-family: var(--font-body);
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  position: relative;
}

/* Scrollbar styling */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--bg-primary);
}

::-webkit-scrollbar-thumb {
  background: var(--bg-secondary);
  border: 2px solid var(--bg-primary);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent-indigo);
}

/* Custom Background Decorative Glows */
.bg-glow-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: -1;
  overflow: hidden;
}

.bg-glow-1 {
  position: absolute;
  top: -10%;
  right: -10%;
  width: 60vw;
  height: 60vw;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(0, 0, 0, 0) 70%);
  filter: blur(80px);
  animation: float-glow 20s infinite alternate;
}

.bg-glow-2 {
  position: absolute;
  bottom: 10%;
  left: -10%;
  width: 50vw;
  height: 50vw;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.1) 0%, rgba(0, 0, 0, 0) 75%);
  filter: blur(80px);
  animation: float-glow 25s infinite alternate-reverse;
}

.bg-glow-3 {
  position: absolute;
  top: 40%;
  left: 30%;
  width: 55vw;
  height: 55vw;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
  filter: blur(100px);
  animation: float-glow 30s infinite alternate;
}

@keyframes float-glow {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(5%, 5%) scale(1.1); }
  100% { transform: translate(-5%, 2%) scale(0.95); }
}

/* Typography & Titles */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  color: var(--text-primary);
  font-weight: 700;
  letter-spacing: -0.02em;
}

p {
  color: var(--text-secondary);
  font-weight: 400;
}

a {
  text-decoration: none;
  color: inherit;
  transition: var(--transition-fast);
}

ul {
  list-style: none;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Layout Utilities */
.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
}

section {
  padding: 7rem 0;
  position: relative;
}

.gradient-text {
  background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent-indigo) 70%, var(--accent-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-accent-text {
  background: linear-gradient(135deg, var(--accent-indigo), var(--accent-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Badge Style */
.badge-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(99, 102, 241, 0.08);
  border: 1px solid rgba(99, 102, 241, 0.2);
  color: var(--accent-indigo);
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.5rem 1.2rem;
  border-radius: 100px;
  margin-bottom: 1.5rem;
  box-shadow: 0 4px 20px rgba(99, 102, 241, 0.05);
}

.badge-tag span {
  display: inline-block;
  width: 6px;
  height: 6px;
  background-color: var(--accent-indigo);
  border-radius: 50%;
  box-shadow: 0 0 8px var(--accent-indigo);
}

/* Premium Section Header */
.section-header {
  max-width: 700px;
  margin-bottom: 4rem;
}

.section-header h2 {
  font-size: 2.8rem;
  line-height: 1.2;
  margin-bottom: 1rem;
}

.section-header p {
  font-size: 1.15rem;
  color: var(--text-secondary);
}

/* Core Buttons Styles */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 600;
  padding: 0.9rem 2rem;
  border-radius: 50px;
  cursor: pointer;
  transition: var(--transition-normal);
  border: none;
  outline: none;
  position: relative;
  overflow: hidden;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-indigo), var(--accent-violet));
  color: var(--text-primary);
  box-shadow: 0 4px 25px rgba(99, 102, 241, 0.3);
}

.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo));
  opacity: 0;
  transition: var(--transition-normal);
  z-index: 1;
}

.btn-primary:hover::before {
  opacity: 1;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 30px rgba(99, 102, 241, 0.45);
}

.btn-primary span, .btn-primary svg {
  position: relative;
  z-index: 2;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.03);
  color: var(--text-primary);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(10px);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
  transform: translateY(-2px);
}

/* --- HEADER / NAVIGATION BAR --- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  transition: var(--transition-normal);
  border-bottom: 1px solid transparent;
}

.header.scrolled {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border);
  padding: 0.6rem 0;
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.2rem 2rem;
  transition: var(--transition-normal);
}

.header.scrolled .header-container {
  padding: 0.8rem 2rem;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--text-primary);
}

.logo-icon {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, var(--accent-indigo), var(--accent-cyan));
  border-radius: 8px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  font-weight: 800;
  font-size: 1.1rem;
  box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
}

.logo span {
  font-weight: 300;
  color: var(--text-secondary);
}

.nav {
  display: flex;
  align-items: center;
  gap: 2.2rem;
}

.nav-link {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-secondary);
  position: relative;
  padding: 0.4rem 0;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent-indigo), var(--accent-cyan));
  transition: var(--transition-fast);
  border-radius: 2px;
}

.nav-link:hover {
  color: var(--text-primary);
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
}

.nav-link.active {
  color: var(--text-primary);
}

.hamburger {
  display: none;
  cursor: pointer;
  background: none;
  border: none;
  z-index: 1010;
}

.hamburger span {
  display: block;
  width: 26px;
  height: 2px;
  background-color: var(--text-primary);
  margin: 6px 0;
  transition: var(--transition-normal);
  border-radius: 2px;
}

/* --- HERO SECTION --- */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: 8rem;
  position: relative;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 4rem;
  align-items: center;
}

.hero-content {
  max-width: 720px;
}

.hero-title {
  font-size: 4.2rem;
  line-height: 1.1;
  font-weight: 800;
  margin-bottom: 1.5rem;
}

.hero-description {
  font-size: 1.25rem;
  color: var(--text-secondary);
  margin-bottom: 2.5rem;
  max-width: 600px;
}

.hero-actions {
  display: flex;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-glow-card {
  width: 100%;
  max-width: 420px;
  aspect-ratio: 1;
  background: radial-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(6, 182, 212, 0.05) 50%, rgba(0, 0, 0, 0) 100%);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 30px;
  backdrop-filter: blur(10px);
  position: relative;
  box-shadow: var(--glass-glow);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 3rem;
  text-align: center;
  animation: float-card 6s ease-in-out infinite;
}

@keyframes float-card {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

.hero-glow-card::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 30px;
  padding: 1px;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.4), rgba(6, 182, 212, 0.1), rgba(139, 92, 246, 0.4));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.hero-glow-icon {
  width: 80px;
  height: 80px;
  background: rgba(99, 102, 241, 0.1);
  border: 1px solid rgba(99, 102, 241, 0.2);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-indigo);
  margin-bottom: 2rem;
  font-size: 2.2rem;
  box-shadow: 0 0 20px rgba(99, 102, 241, 0.2);
}

.hero-glow-card h3 {
  font-size: 1.8rem;
  margin-bottom: 0.8rem;
}

.hero-glow-card p {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* --- SERVICES --- */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

.service-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  padding: 2.5rem;
  transition: var(--transition-normal);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), rgba(99, 102, 241, 0.08), transparent 40%);
  opacity: 0;
  transition: opacity 0.5s ease;
  z-index: 1;
  pointer-events: none;
}

.service-card:hover::before {
  opacity: 1;
}

.service-card:hover {
  transform: translateY(-8px);
  border-color: rgba(99, 102, 241, 0.25);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(99, 102, 241, 0.05);
}

.service-icon {
  width: 60px;
  height: 60px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-indigo);
  font-size: 1.6rem;
  margin-bottom: 2rem;
  transition: var(--transition-normal);
  position: relative;
  z-index: 2;
}

.service-card:hover .service-icon {
  background: rgba(99, 102, 241, 0.1);
  border-color: rgba(99, 102, 241, 0.3);
  color: var(--accent-cyan);
  box-shadow: 0 0 15px rgba(99, 102, 241, 0.25);
}

.service-card h3 {
  font-size: 1.5rem;
  margin-bottom: 1rem;
  position: relative;
  z-index: 2;
}

.service-card p {
  font-size: 1rem;
  color: var(--text-secondary);
  margin-bottom: 2rem;
  flex-grow: 1;
  position: relative;
  z-index: 2;
}

.service-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--text-primary);
  position: relative;
  z-index: 2;
}

.service-link svg {
  transition: transform var(--transition-fast);
}

.service-card:hover .service-link {
  color: var(--accent-cyan);
}

.service-card:hover .service-link svg {
  transform: translateX(5px);
}

/* --- STAFF AUGMENTATION --- */
.staff-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 5rem;
  align-items: center;
}

.staff-features {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.staff-feature-card {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 2rem;
  transition: var(--transition-normal);
}

.staff-feature-card:hover {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(6, 182, 212, 0.2);
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
}

.staff-feature-card h4 {
  font-size: 1.25rem;
  margin-bottom: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.staff-feature-card h4 svg {
  color: var(--accent-cyan);
}

.staff-feature-card p {
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.staff-visual-wrapper {
  background: radial-gradient(135deg, rgba(12, 16, 36, 0.8) 0%, rgba(6, 8, 20, 0.9) 100%);
  border: 1px solid var(--glass-border);
  border-radius: 30px;
  padding: 3rem;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--glass-glow);
}

.staff-visual-wrapper::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 30px;
  padding: 1px;
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.3), transparent 60%, rgba(99, 102, 241, 0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.staff-visual-globe {
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, rgba(99, 102, 241, 0.05) 50%, rgba(0, 0, 0, 0) 75%);
  border: 1px dashed rgba(6, 182, 212, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 2.5rem;
  animation: rotate-globe 40s linear infinite;
}

@keyframes rotate-globe {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.staff-visual-globe-pulse {
  position: absolute;
  width: 14px;
  height: 14px;
  background-color: var(--accent-cyan);
  border-radius: 50%;
  box-shadow: 0 0 15px var(--accent-cyan);
  animation: pulse-dot 2s infinite;
}

.staff-visual-globe-pulse:nth-child(1) { top: 20%; left: 30%; }
.staff-visual-globe-pulse:nth-child(2) { bottom: 25%; right: 20%; }
.staff-visual-globe-pulse:nth-child(3) { top: 60%; left: 70%; }

@keyframes pulse-dot {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.7); }
  70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(6, 182, 212, 0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(6, 182, 212, 0); }
}

.staff-visual-wrapper h3 {
  font-size: 1.8rem;
  margin-bottom: 0.8rem;
}

.staff-visual-wrapper p {
  font-size: 1rem;
  max-width: 320px;
  margin-bottom: 2rem;
}

/* --- AI SOLUTIONS SHOWCASE --- */
.ai-solutions-wrapper {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 30px;
  padding: 3rem;
  backdrop-filter: blur(10px);
  box-shadow: var(--glass-glow);
}

.ai-solutions-grid {
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  gap: 3.5rem;
}

.ai-tabs-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.ai-tab-btn {
  background: none;
  border: 1px solid transparent;
  color: var(--text-secondary);
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 600;
  text-align: left;
  padding: 1.2rem 1.8rem;
  border-radius: 16px;
  cursor: pointer;
  transition: var(--transition-normal);
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.ai-tab-btn:hover {
  background: rgba(255, 255, 255, 0.02);
  color: var(--text-primary);
}

.ai-tab-btn.active {
  background: rgba(99, 102, 241, 0.08);
  border-color: rgba(99, 102, 241, 0.2);
  color: var(--text-primary);
  box-shadow: 0 4px 20px rgba(99, 102, 241, 0.05);
}

.ai-tab-btn svg {
  opacity: 0;
  transform: translateX(-10px);
  transition: var(--transition-normal);
  color: var(--accent-indigo);
}

.ai-tab-btn.active svg {
  opacity: 1;
  transform: translateX(0);
}

.ai-content-panel {
  display: none;
  animation: fade-in-panel var(--transition-normal) forwards;
}

.ai-content-panel.active {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

@keyframes fade-in-panel {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

.ai-panel-header {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.ai-panel-num {
  font-family: var(--font-display);
  font-size: 2.5rem;
  font-weight: 800;
  color: rgba(99, 102, 241, 0.2);
  border: 1px solid rgba(99, 102, 241, 0.1);
  border-radius: 16px;
  width: 70px;
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-content-panel h3 {
  font-size: 2.2rem;
  line-height: 1.2;
}

.ai-content-panel .description {
  font-size: 1.2rem;
  color: var(--text-secondary);
  margin-bottom: 2.5rem;
  max-width: 640px;
  line-height: 1.7;
}

.ai-capabilities-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.ai-capability-item {
  display: flex;
  gap: 1rem;
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  padding: 1.5rem;
  border-radius: 16px;
  transition: var(--transition-normal);
}

.ai-capability-item:hover {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(99, 102, 241, 0.25);
  transform: translateY(-2px);
}

.ai-cap-icon {
  color: var(--accent-indigo);
  font-size: 1.25rem;
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.ai-capability-item h4 {
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
}

.ai-capability-item p {
  font-size: 0.9rem;
  color: var(--text-secondary);
}

/* --- CASE STUDIES / OUR WORK --- */
.portfolio-featured {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 30px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  margin-bottom: 4rem;
  box-shadow: var(--glass-glow);
}

.portfolio-featured-visual {
  background: linear-gradient(135deg, #1e1b4b 0%, #311042 100%);
  position: relative;
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem;
}

.featured-visual-app {
  width: 80%;
  max-width: 320px;
  background: #0f172a;
  border: 4px solid rgba(255, 255, 255, 0.08);
  border-radius: 32px;
  aspect-ratio: 9/16;
  padding: 1.5rem;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.app-header span {
  font-size: 0.8rem;
  font-weight: bold;
}

.app-mood-circle {
  flex-grow: 1;
  border-radius: 20px;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, rgba(99, 102, 241, 0.05) 100%);
  border: 1px solid rgba(139, 92, 246, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1rem;
}

.mood-smile {
  font-size: 3rem;
  color: var(--accent-violet);
  margin-bottom: 1rem;
  animation: mood-bounce 3s infinite ease-in-out;
}

@keyframes mood-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.app-mood-circle h4 {
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
}

.app-mood-circle p {
  font-size: 0.75rem;
}

.portfolio-featured-content {
  padding: 4rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.portfolio-featured-content h3 {
  font-size: 2.2rem;
  margin-bottom: 0.5rem;
}

.portfolio-featured-content h4 {
  font-size: 1.25rem;
  color: var(--accent-cyan);
  margin-bottom: 1.5rem;
  font-weight: 500;
}

.portfolio-featured-content p {
  font-size: 1.1rem;
  color: var(--text-secondary);
  margin-bottom: 2.5rem;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.portfolio-card {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  overflow: hidden;
  transition: var(--transition-normal);
  display: flex;
  flex-direction: column;
  height: 100%;
}

.portfolio-card:hover {
  transform: translateY(-6px);
  border-color: rgba(99, 102, 241, 0.2);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
}

.portfolio-card-visual {
  height: 200px;
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid var(--glass-border);
  position: relative;
}

.portfolio-card-visual svg {
  font-size: 3rem;
  color: rgba(255, 255, 255, 0.1);
  transition: var(--transition-normal);
}

.portfolio-card:hover .portfolio-card-visual svg {
  color: var(--accent-indigo);
  transform: scale(1.1);
}

.portfolio-card-body {
  padding: 2rem;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.portfolio-card-body h4 {
  font-size: 1.3rem;
  margin-bottom: 0.5rem;
}

.portfolio-card-body .category {
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--accent-cyan);
  letter-spacing: 0.05em;
  margin-bottom: 1rem;
}

.portfolio-card-body p {
  font-size: 0.95rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  flex-grow: 1;
}

/* --- INDUSTRIES WE SERVE --- */
.industries-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
}

.industry-card {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 2rem;
  text-align: center;
  transition: var(--transition-normal);
}

.industry-card:hover {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(139, 92, 246, 0.25);
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
}

.industry-icon {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-violet);
  font-size: 1.4rem;
  margin: 0 auto 1.5rem auto;
  transition: var(--transition-normal);
}

.industry-card:hover .industry-icon {
  background: rgba(139, 92, 246, 0.1);
  color: var(--accent-cyan);
  box-shadow: 0 0 12px rgba(139, 92, 246, 0.25);
}

.industry-card h4 {
  font-size: 1.2rem;
  margin-bottom: 0.75rem;
}

.industry-card p {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* --- TESTIMONIALS --- */
.testimonials-slider-container {
  max-width: 860px;
  margin: 0 auto;
  position: relative;
  overflow: hidden;
}

.testimonial-track {
  display: flex;
  transition: transform var(--transition-slow);
}

.testimonial-slide {
  min-width: 100%;
  padding: 2rem;
}

.testimonial-card {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 30px;
  padding: 3.5rem;
  position: relative;
  box-shadow: var(--glass-glow);
}

.testimonial-card::before {
  content: '“';
  position: absolute;
  top: 1rem;
  left: 2.5rem;
  font-size: 8rem;
  color: rgba(99, 102, 241, 0.1);
  font-family: serif;
  line-height: 1;
}

.testimonial-quote {
  font-size: 1.35rem;
  line-height: 1.7;
  color: var(--text-primary);
  font-style: italic;
  margin-bottom: 2.5rem;
  position: relative;
  z-index: 2;
}

.testimonial-author {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  position: relative;
  z-index: 2;
}

.author-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-indigo), var(--accent-cyan));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  font-weight: 700;
  font-size: 1.2rem;
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
}

.author-info h4 {
  font-size: 1.15rem;
  margin-bottom: 0.25rem;
}

.author-info p {
  font-size: 0.9rem;
  color: var(--text-muted);
}

.slider-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  margin-top: 2rem;
}

.slider-arrow {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  cursor: pointer;
  transition: var(--transition-fast);
}

.slider-arrow:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
  color: var(--accent-indigo);
}

.slider-dots {
  display: flex;
  gap: 0.5rem;
}

.slider-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition-fast);
}

.slider-dot.active {
  background-color: var(--accent-indigo);
  width: 20px;
  border-radius: 100px;
}

/* --- OUR PROCESS TIMELINE --- */
.process-timeline {
  position: relative;
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem 0;
}

.process-timeline::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2px;
  background: linear-gradient(to bottom, var(--accent-indigo) 10%, rgba(6, 182, 212, 0.3) 50%, var(--glass-border) 90%);
  transform: translateX(-50%);
}

.process-step {
  display: flex;
  justify-content: flex-end;
  position: relative;
  margin-bottom: 5rem;
  width: 50%;
}

.process-step:nth-child(even) {
  align-self: flex-end;
  justify-content: flex-start;
  margin-left: 50%;
}

.process-indicator {
  position: absolute;
  top: 1.5rem;
  right: -15px;
  width: 30px;
  height: 30px;
  background-color: var(--bg-primary);
  border: 3px solid var(--glass-border);
  border-radius: 50%;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-normal);
}

.process-step:nth-child(even) .process-indicator {
  left: -15px;
  right: auto;
}

.process-step.active .process-indicator {
  border-color: var(--accent-indigo);
  box-shadow: 0 0 15px var(--accent-indigo);
}

.process-indicator::after {
  content: '';
  width: 8px;
  height: 8px;
  background-color: var(--text-muted);
  border-radius: 50%;
  transition: var(--transition-normal);
}

.process-step.active .process-indicator::after {
  background-color: var(--accent-indigo);
}

.process-card {
  width: 85%;
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  padding: 2.2rem;
  transition: var(--transition-normal);
  position: relative;
}

.process-card:hover {
  background: rgba(255, 255, 255, 0.02);
  border-color: rgba(99, 102, 241, 0.25);
  transform: translateY(-4px);
}

.process-step.active .process-card {
  border-color: rgba(99, 102, 241, 0.3);
  box-shadow: 0 10px 30px rgba(99, 102, 241, 0.06);
}

.process-num {
  font-family: var(--font-display);
  font-size: 2.2rem;
  font-weight: 800;
  color: rgba(99, 102, 241, 0.2);
  margin-bottom: 0.5rem;
}

.process-card h3 {
  font-size: 1.4rem;
  margin-bottom: 0.75rem;
}

.process-card p {
  font-size: 0.95rem;
  color: var(--text-secondary);
}

/* --- ABOUT US & TECH STACK --- */
.about-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 5rem;
  align-items: center;
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.about-stat-item {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 2.2rem;
  text-align: center;
  transition: var(--transition-normal);
}

.about-stat-item:hover {
  background: rgba(255, 255, 255, 0.03);
  transform: translateY(-4px);
}

.stat-number {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.stat-label {
  font-size: 0.95rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.tech-stack-wrapper {
  margin-top: 3.5rem;
}

.tech-stack-title {
  font-size: 1.1rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
  font-weight: 600;
}

.tech-badges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
}

.tech-badge {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  padding: 0.6rem 1.2rem;
  border-radius: 100px;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 500;
  transition: var(--transition-fast);
  color: var(--text-secondary);
}

.tech-badge:hover {
  background: rgba(99, 102, 241, 0.08);
  border-color: rgba(99, 102, 241, 0.3);
  color: var(--text-primary);
  transform: translateY(-2px);
}

/* --- CONTACT US --- */
.contact-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 5rem;
  align-items: center;
}

.contact-form-wrapper {
  background: rgba(255, 255, 255, 0.01);
  border: 1px solid var(--glass-border);
  border-radius: 30px;
  padding: 3.5rem;
  backdrop-filter: blur(10px);
  box-shadow: var(--glass-glow);
  position: relative;
  overflow: hidden;
}

.contact-form-wrapper::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 30px;
  padding: 1px;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), transparent 60%, rgba(6, 182, 212, 0.25));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.contact-form-title {
  margin-bottom: 2rem;
}

.contact-form-title h3 {
  font-size: 2.2rem;
  margin-bottom: 0.5rem;
}

.contact-form-title p {
  color: var(--text-secondary);
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.form-group {
  margin-bottom: 1.5rem;
  position: relative;
}

.form-group label {
  display: block;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.form-control {
  width: 100%;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  padding: 1rem 1.25rem;
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--text-primary);
  outline: none;
  transition: var(--transition-fast);
}

.form-control::placeholder {
  color: var(--text-muted);
}

.form-control:focus {
  background: rgba(255, 255, 255, 0.04);
  border-color: var(--accent-indigo);
  box-shadow: 0 0 10px rgba(99, 102, 241, 0.15);
}

textarea.form-control {
  min-height: 120px;
  resize: vertical;
}

/* Form Radio Group styling */
.form-radio-label {
  display: block;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.8rem;
}

.radio-group {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-bottom: 2rem;
}

.radio-btn-card {
  position: relative;
  display: block;
}

.radio-btn-card input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.radio-btn-card-content {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: 10px;
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
  text-align: center;
  cursor: pointer;
  transition: var(--transition-fast);
  display: block;
  font-weight: 500;
}

.radio-btn-card:hover .radio-btn-card-content {
  background: rgba(255, 255, 255, 0.05);
}

.radio-btn-card input[type="radio"]:checked + .radio-btn-card-content {
  background: rgba(99, 102, 241, 0.1);
  border-color: var(--accent-indigo);
  color: var(--text-primary);
}

/* Error message label */
.error-msg {
  color: #ef4444;
  font-size: 0.8rem;
  margin-top: 0.4rem;
  display: none;
}

.form-group.has-error .form-control {
  border-color: #ef4444;
  box-shadow: 0 0 10px rgba(239, 68, 68, 0.15);
}

.form-group.has-error .error-msg {
  display: block;
}

/* Success overlay state */
.form-success-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--bg-secondary);
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.form-success-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.success-icon {
  width: 80px;
  height: 80px;
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #10b981;
  font-size: 2.5rem;
  margin-bottom: 2rem;
  box-shadow: 0 0 25px rgba(16, 185, 129, 0.2);
}

.form-success-overlay h3 {
  font-size: 2rem;
  margin-bottom: 0.8rem;
}

.form-success-overlay p {
  color: var(--text-secondary);
  font-size: 1.05rem;
}

/* Contact Info Column */
.contact-info-column {
  display: flex;
  flex-direction: column;
  gap: 3.5rem;
}

.contact-info-details {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.contact-info-item {
  display: flex;
  gap: 1.5rem;
}

.contact-info-icon {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-indigo);
  font-size: 1.3rem;
  flex-shrink: 0;
}

.contact-info-text h4 {
  font-size: 1.15rem;
  margin-bottom: 0.4rem;
}

.contact-info-text p {
  font-size: 0.95rem;
  color: var(--text-secondary);
}

.contact-info-rocket {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 180px;
}

.rocket-glow {
  position: absolute;
  width: 140px;
  height: 140px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(0, 0, 0, 0) 70%);
  filter: blur(10px);
}

.rocket-svg-wrapper {
  animation: rocket-float 4s ease-in-out infinite;
  color: var(--accent-indigo);
}

@keyframes rocket-float {
  0%, 100% { transform: translateY(0) rotate(45deg); }
  50% { transform: translateY(-12px) rotate(45deg); }
}

/* --- FOOTER --- */
.footer {
  background: #03050c;
  border-top: 1px solid var(--glass-border);
  padding: 5rem 0 2.5rem 0;
  position: relative;
  z-index: 10;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr repeat(3, 1fr);
  gap: 4rem;
  margin-bottom: 4rem;
}

.footer-brand p {
  margin-top: 1.25rem;
  color: var(--text-secondary);
  font-size: 0.95rem;
  max-width: 300px;
}

.footer-col h4 {
  font-size: 1.1rem;
  margin-bottom: 1.5rem;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.footer-link {
  font-size: 0.95rem;
  color: var(--text-secondary);
}

.footer-link:hover {
  color: var(--accent-indigo);
  transform: translateX(4px);
}

.footer-socials {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
}

.social-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  transition: var(--transition-fast);
}

.social-icon:hover {
  background: rgba(99, 102, 241, 0.1);
  border-color: var(--accent-indigo);
  color: var(--text-primary);
  transform: translateY(-2px);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding-top: 2.5rem;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.footer-bottom-links {
  display: flex;
  gap: 2rem;
}

/* --- RESPONSIVE MEDIA QUERIES --- */
@media (max-width: 1024px) {
  html {
    font-size: 15px;
  }
  
  .hero-title {
    font-size: 3.5rem;
  }
  
  .hero-grid,
  .staff-grid,
  .ai-solutions-grid,
  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 4rem;
  }
  
  .hero-content, .hero-visual {
    max-width: 100%;
  }
  
  .hero-visual {
    order: -1;
  }
  
  .about-stats {
    order: 1;
  }
  
  .portfolio-featured {
    grid-template-columns: 1fr;
  }
  
  .portfolio-featured-visual {
    min-height: 350px;
  }
  
  .portfolio-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .process-timeline::before {
    left: 2rem;
  }
  
  .process-step {
    width: 100%;
    justify-content: flex-start;
    padding-left: 4.5rem;
    margin-bottom: 3.5rem;
  }
  
  .process-step:nth-child(even) {
    margin-left: 0;
  }
  
  .process-indicator {
    left: calc(2rem - 15px) !important;
    right: auto !important;
  }
  
  .process-card {
    width: 100%;
  }
}

@media (max-width: 768px) {
  section {
    padding: 5rem 0;
  }
  
  .section-header h2 {
    font-size: 2.2rem;
  }
  
  .hamburger {
    display: block;
  }
  
  .hamburger.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  
  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  
  .hamburger.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  
  .nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 80%;
    max-width: 320px;
    height: 100vh;
    background: var(--bg-secondary);
    border-left: 1px solid var(--glass-border);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    z-index: 1000;
    transition: right var(--transition-normal);
  }
  
  .nav.active {
    right: 0;
  }
  
  .header-actions {
    display: none; /* Hide top CTA in mobile nav container */
  }
  
  .hero-title {
    font-size: 2.8rem;
  }
  
  .staff-features {
    grid-template-columns: 1fr;
  }
  
  .portfolio-grid {
    grid-template-columns: 1fr;
  }
  
  .testimonial-card {
    padding: 2.2rem;
  }
  
  .testimonial-quote {
    font-size: 1.15rem;
  }
  
  .radio-group {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .contact-form-wrapper {
    padding: 2.2rem;
  }
  
  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
  
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  
  .footer-bottom {
    flex-direction: column;
    gap: 1.5rem;
    text-align: center;
  }
  
  .footer-bottom-links {
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 2.4rem;
  }
  
  .hero-actions {
    flex-direction: column;
    width: 100%;
  }
  
  .hero-actions .btn {
    width: 100%;
  }
  
  .radio-group {
    grid-template-columns: 1fr;
  }
}
