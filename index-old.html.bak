  <!-- Contact Us Section -->
  <section class="contact" id="contact">
    <div class="container contact-grid">
      <div class="contact-form-wrapper">
        <!-- Interactive Success Overlay -->
        <div class="form-success-overlay" id="form-success">
          <div class="success-icon">&#10004;</div>
          <h3>Message Sent!</h3>
          <p>Thank you for reaching out. A HackerKernel solution specialist will contact you in under 12 hours.</p>
          <button class="btn btn-secondary" style="margin-top: 2rem;" onclick="resetForm()">Send Another Message</button>
        </div>

        <div class="contact-form-title">
          <h3>Have an Idea?</h3>
          <p class="gradient-accent-text" style="font-weight: 700; font-size: 1.5rem; font-family: var(--font-display);">We'll Build It.</p>
        </div>

        <form id="project-form" novalidate>
          <div class="form-row">
            <div class="form-group" id="group-name">
              <label for="name">Your Name</label>
              <input type="text" id="name" class="form-control" placeholder="Enter Name">
              <div class="error-msg">Please enter your name.</div>
            </div>
            <div class="form-group" id="group-email">
              <label for="email">Email Address</label>
              <input type="email" id="email" class="form-control" placeholder="Enter Email">
              <div class="error-msg">Please enter a valid email.</div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group" id="group-phone">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" class="form-control" placeholder="Enter Phone Number">
              <div class="error-msg">Please enter a valid phone number.</div>
            </div>
            <div class="form-group" id="group-message">
              <label for="message">Message</label>
              <textarea id="message" class="form-control" placeholder="Tell us briefly about your project"></textarea>
              <div class="error-msg">Please enter a brief message.</div>
            </div>
          </div>

          <div class="form-group">
            <span class="form-radio-label">How Did You Hear About Us?</span>
            <div class="radio-group">
              <label class="radio-btn-card">
                <input type="radio" name="source" value="Google" checked>
                <span class="radio-btn-card-content">Google</span>
              </label>
              <label class="radio-btn-card">
                <input type="radio" name="source" value="LinkedIn">
                <span class="radio-btn-card-content">LinkedIn</span>
              </label>
              <label class="radio-btn-card">
                <input type="radio" name="source" value="Friend">
                <span class="radio-btn-card-content">Referral</span>
              </label>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">
            <span>Submit Inquiry</span>
          </button>
        </form>
      </div>

      <div class="contact-info-column">
        <div class="contact-info-details">
          <!-- Info Item 1 -->
          <div class="contact-info-item">
            <div class="contact-info-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="contact-info-text">
              <h4>Email Inquiries</h4>
              <p>sales@hackerkernel.com</p>
            </div>
          </div>

          <!-- Info Item 2 -->
          <div class="contact-info-item">
            <div class="contact-info-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div class="contact-info-text">
              <h4>Headquarters</h4>
              <p>Bhopal, Madhya Pradesh, India</p>
            </div>
          </div>
        </div>

        <!-- 3D float visual alternative with CSS animations -->
        <div class="contact-info-rocket">
          <div class="rocket-glow"></div>
          <div class="rocket-svg-wrapper">
            <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2.5 3.19-2.5 5.5h6c0-2.31-1-4.24-2.5-5.5z"></path><path d="M12 2C6.48 2 2 6.48 2 12c0 2.21.72 4.25 1.93 5.92l4.82-4.82C8.28 12.3 8 11.18 8 10c0-2.21 1.79-4 4-4s4 1.79 4 4c0 1.18-.28 2.3-.75 3.1l4.82 4.82C21.28 16.25 22 14.21 22 12c0-5.52-4.48-10-10-10z"></path><path d="M19.5 16.5c1.5 1.26 2.5 3.19 2.5 5.5h-6c0-2.31 1-4.24 2.5-5.5z"></path></svg>
          </div>
        </div>
      </div>
    </div>
  </section>

