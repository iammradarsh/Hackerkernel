  <!-- Industries We Serve Section -->
  <section class="industries" id="industries">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag"><span></span>Serves Worldwide</div>
        <h2>Industries We Empower</h2>
        <p>We engineer solutions that solve real-world problems and scale beautifully across multiple industry verticals.</p>
      </div>

      <div class="industries-grid">
        <!-- Industry 1 -->
        <div class="industry-card">
          <div class="industry-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h4>FinTech</h4>
          <p>Compliance-ready transaction platforms, banking gateways, and analytical portals.</p>
        </div>

        <!-- Industry 2 -->
        <div class="industry-card">
          <div class="industry-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
          </div>
          <h4>HealthTech</h4>
          <p>Intuitive EHR portals, telemedicine software, and secure clinical trackers.</p>
        </div>

        <!-- Industry 3 -->
        <div class="industry-card">
          <div class="industry-icon">
