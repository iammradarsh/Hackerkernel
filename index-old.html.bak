  <meta name="description" content="We build premium tech products for global brands and startups. Leverage top-tier developer talent, scalable staff augmentation, and cutting-edge artificial intelligence solutions.">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2225%22 fill=%22%236366f1%22/><text y=%22.9em%22 font-size=%2280%22 fill=%22white%22 font-family=%22sans-serif%22 font-weight=%22bold%22>HK</text></svg>">

