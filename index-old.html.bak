  <!-- AI Solutions Showcase -->
  <section class="ai-solutions" id="ai-solutions">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag"><span></span>Artificial Intelligence</div>
        <h2>Enterprise AI Solutions</h2>
        <p>We leverage cutting-edge Artificial Intelligence models to automate business processes, gain deep insights, and build high-performance tools.</p>
      </div>

      <div class="ai-solutions-wrapper">
        <div class="ai-solutions-grid">
          <!-- Vertical Tabs Button List -->
          <div class="ai-tabs-list">
            <button class="ai-tab-btn active" data-tab="cust-service">
              <span>Customer Service AI</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <button class="ai-tab-btn" data-tab="procurement">
              <span>Procurement & Contracts</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <button class="ai-tab-btn" data-tab="hr">
              <span>HR & Recruitment</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <button class="ai-tab-btn" data-tab="sales">
              <span>Sales & Marketing Automation</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <button class="ai-tab-btn" data-tab="finance">
              <span>Finance Operations</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <button class="ai-tab-btn" data-tab="it-ops">
              <span>IT & Infrastructure Ops</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>

          <!-- Dynamic Panels Content -->
          <div class="ai-panels-container">
            <!-- Panel 1: Customer Service -->
            <div class="ai-content-panel active" id="cust-service">
              <div class="ai-panel-header">
                <div class="ai-panel-num">01</div>
                <h3>AI for Customer Service</h3>
              </div>
              <p class="description">
                AI agents that instantly resolve Tier 1 queries, summarize complex tickets, and intelligently prioritize escalations. Give your clients rapid support while scaling operational costs down.
              </p>
              <div class="ai-capabilities-grid">
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Conversational Agents</h4>
                    <p>Highly human-like support agents trained directly on your business knowledge base.</p>
                  </div>
                </div>
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Smart Escalations</h4>
                    <p>Identify sentiment patterns and route complex requests to human agents with summarized history.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Panel 2: Procurement -->
            <div class="ai-content-panel" id="procurement">
              <div class="ai-panel-header">
                <div class="ai-panel-num">02</div>
                <h3>AI for Procurement</h3>
              </div>
              <p class="description">
                Automate vendor risk assessments, extract critical terms from complex supplier contracts, and forecast supply chain disruptions using historical data trends.
              </p>
              <div class="ai-capabilities-grid">
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Contract Extraction</h4>
                    <p>Extract risk terms, liabilities, and custom compliance requirements automatically from PDFs.</p>
                  </div>
                </div>
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Disruption Forecasting</h4>
                    <p>Analyze weather, shipping times, and supplier histories to predict delays before they affect you.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Panel 3: HR -->
            <div class="ai-content-panel" id="hr">
              <div class="ai-panel-header">
                <div class="ai-panel-num">03</div>
                <h3>AI for HR</h3>
              </div>
              <p class="description">
                Streamline candidate screening, generate personalized employee onboarding schedules, and answer employee policy questions instantly through a custom conversational portal.
              </p>
              <div class="ai-capabilities-grid">
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Screening Automation</h4>
                    <p>Match complex resume profiles with strict requirements without human bias.</p>
                  </div>
                </div>
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Interactive Policy Q&A</h4>
                    <p>Employees query insurance, leaves, and handbook questions directly with immediate responses.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Panel 4: Sales -->
            <div class="ai-content-panel" id="sales">
              <div class="ai-panel-header">
                <div class="ai-panel-num">04</div>
                <h3>AI for Sales & Marketing</h3>
              </div>
              <p class="description">
                Tailor lead scoring models, automate intelligent follow-up email sequences, and generate hyper-personalized sales outreach pitches based on prospect social profiles.
              </p>
              <div class="ai-capabilities-grid">
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Predictive Scoring</h4>
                    <p>Identify warm opportunities and rank leads automatically by intent triggers and activity.</p>
                  </div>
                </div>
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Hyper-Personalized Outreach</h4>
                    <p>Generate highly engaging custom messaging sequences at scale based on company research.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Panel 5: Finance -->
            <div class="ai-content-panel" id="finance">
              <div class="ai-panel-header">
                <div class="ai-panel-num">05</div>
                <h3>AI for Finance</h3>
              </div>
              <p class="description">
                Detect anomalies in expense reports automatically, categorize raw transactions with high accuracy, and generate preliminary narrative insights for quarterly reports.
              </p>
              <div class="ai-capabilities-grid">
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Anomaly Auditing</h4>
                    <p>Identify unusual payment spikes, duplicate invoices, and outlier charges in milliseconds.</p>
                  </div>
                </div>
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Insight Generation</h4>
                    <p>Turn numbers and ledger logs into executive summaries and formatted tables instantly.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Panel 6: IT Ops -->
            <div class="ai-content-panel" id="it-ops">
              <div class="ai-panel-header">
                <div class="ai-panel-num">06</div>
                <h3>AI for IT Operations</h3>
              </div>
              <p class="description">
                Predict server outages before they occur, automate routine infrastructure provisioning, and accelerate incident root-cause analysis through automated log parsing.
              </p>
              <div class="ai-capabilities-grid">
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Outage Prediction</h4>
                    <p>Proactively monitor load limits and system performance markers to flag risk trends.</p>
                  </div>
                </div>
                <div class="ai-capability-item">
                  <div class="ai-cap-icon">&#10003;</div>
                  <div>
                    <h4>Root-Cause Extraction</h4>
                    <p>Accelerate system resolution by locating logs and parsing traces instantly with LLMs.</p>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies / Portfolio Section -->
