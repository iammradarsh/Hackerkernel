        <a href="#about" class="nav-link">About</a>
        <a href="#contact" class="nav-link">Contact</a>
      </nav>

      <div class="header-actions">
        <a href="#contact" class="btn btn-secondary" style="padding: 0.6rem 1.4rem; font-size: 0.85rem;">Let's Talk</a>
      </div>

      <button class="hamburger" id="hamburger-menu" aria-label="Toggle Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="badge-tag">
          <span></span>#BuiltToPerform
        </div>
        <h1 class="hero-title">
          Architecting <span class="gradient-text">Scalable Software</span> & Smart AI
        </h1>
        <p class="hero-description">
          HackerKernel empowers global enterprises and fast-growing startups with top-tier developer talent, custom digital engineering, and custom Artificial Intelligence solutions.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">
            <span>Find Your Perfect Team</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="#portfolio" class="btn btn-secondary">Explore Our Work</a>
        </div>
      </div>
      
      <div class="hero-visual">
        <div class="hero-glow-card">
          <div class="hero-glow-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3>200+ Projects</h3>
          <p>Delivered worldwide with exceptional engineering standards and state-of-the-art architectures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="services" id="services">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag"><span></span>What We Offer</div>
        <h2>Our Core Capabilities</h2>
        <p>Explore the world through the lens of our visual and technical expertise and find what suits your business best.</p>
      </div>

      <div class="services-grid">
        <!-- Service 1 -->
        <div class="service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <h3>Web Development</h3>
          <p>Highly scalable, fast-loading, and responsive enterprise web portals and cloud application suites designed for modern businesses.</p>
          <a href="#contact" class="service-link">
            <span>Learn More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>

        <!-- Service 2 -->
        <div class="service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
          </div>
          <h3>Mobile App Development</h3>
          <p>Robust native iOS, Android, and hybrid cross-platform mobile apps built to engage users and scale dynamically as userbases grow.</p>
          <a href="#contact" class="service-link">
            <span>Learn More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>

        <!-- Service 3 -->
        <div class="service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor"></path><path d="M12 8V16M8 12H16" stroke="currentColor"></path></svg>
          </div>
          <h3>UI/UX Designing</h3>
          <p>Exceptional and intuitive user experiences engineered through meticulous user research, smooth prototyping, and high-end animations.</p>
          <a href="#contact" class="service-link">
            <span>Learn More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Staff Augmentation Section -->
  <section class="staff-aug" id="staff-aug">
    <div class="container staff-grid">
      <div class="staff-content">
        <div class="badge-tag"><span></span>Why Staff Augmentation</div>
        <h2>Scale Instantly With Specialized Developers</h2>
        <p class="hero-description" style="margin-bottom: 2.5rem;">
          We empower industries by combining the right talent, cutting-edge solutions, and seamless integration practices to meet evolving corporate business needs.
        </p>

        <div class="staff-features">
          <!-- Feature 1 -->
          <div class="staff-feature-card">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
              Rapid Onboarding
            </h4>
            <p>Get fully-aligned technical resources integrated into your team in days, not weeks.</p>
          </div>

          <!-- Feature 2 -->
          <div class="staff-feature-card">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              Dedicated Teams
            </h4>
            <p>100% focused full-time developers aligned completely with your objectives.</p>
          </div>

          <!-- Feature 3 -->
          <div class="staff-feature-card">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
              Scalable Teams
            </h4>
            <p>Scale technical resources up or down dynamically depending on project milestones.</p>
          </div>

          <!-- Feature 4 -->
          <div class="staff-feature-card">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              Full Control
            </h4>
            <p>You manage the scope and direction, while we handle HR, support, and infrastructure.</p>
          </div>
        </div>
      </div>

      <div class="staff-visual">
        <div class="staff-visual-wrapper">
          <div class="staff-visual-globe">
            <div class="staff-visual-globe-pulse"></div>
            <div class="staff-visual-globe-pulse"></div>
            <div class="staff-visual-globe-pulse"></div>
            <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="rgba(6, 182, 212, 0.4)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path><path d="M2 12h20"></path></svg>
          </div>
          <h3>Global Operations</h3>
          <p>Access exceptional engineers based in India working with companies worldwide.</p>
          <a href="#contact" class="btn btn-primary" style="width: 100%;">
            <span>Find Developers Now</span>
          </a>
        </div>
      </div>
    </div>
