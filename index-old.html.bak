  <!-- Process Timeline Section -->
  <section class="process" id="process">
    <div class="container">
      <div class="section-header">
        <div class="badge-tag"><span></span>Our Flow</div>
        <h2>Engineering Process</h2>
        <p>How we shape raw startup ideas, model architectures, design, and deploy flawless digital products.</p>
      </div>

      <div class="process-timeline" id="timeline">
        <!-- Step 1 -->
        <div class="process-step active">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">01.</div>
            <h3>Requirement Gathering</h3>
            <p>Meticulously capturing business concepts, product objectives, operational requirements, and your long-term roadmap goals.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="process-step">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">02.</div>
            <h3>Analysis & Idea Molding</h3>
            <p>Translating captured data into architectural guides, selecting language frameworks, and setting project milestones.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="process-step">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">03.</div>
            <h3>UI/UX Designing</h3>
            <p>Designing interactive, gorgeous, and premium layout wireframes that represent your brand aesthetics and delight users.</p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="process-step">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">04.</div>
            <h3>Product Development</h3>
            <p>Writing clean, production-grade, and compile-ready code inside structured cloud repositories under continuous pipelines.</p>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="process-step">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">05.</div>
            <h3>Quality Analysis</h3>
            <p>Conducting extensive automated unit testing, manual browser checks, and security audits to ensure perfect operation.</p>
          </div>
        </div>

        <!-- Step 6 -->
        <div class="process-step">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">06.</div>
            <h3>Final Deployment</h3>
            <p>Deploying products to hosting systems and production pipelines, giving your business immediate market presence.</p>
          </div>
        </div>

        <!-- Step 7 -->
        <div class="process-step">
          <div class="process-indicator"></div>
          <div class="process-card">
            <div class="process-num">07.</div>
            <h3>Client Support</h3>
            <p>Long-term maintenance support, performance updates, framework migrations, and continued feature expansions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Us Section -->
  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-stats">
        <div class="about-stat-item">
          <div class="stat-number gradient-accent-text">6+</div>
          <div class="stat-label">Years of Excellence</div>
        </div>
        <div class="about-stat-item">
          <div class="stat-number gradient-accent-text">200+</div>
